NODE_ENV=development
APP_VERSION=0.1.0

POSTGRES_DB=implantahub
POSTGRES_ADMIN_PASSWORD=postgres
DATABASE_URL=postgresql://implantahub_api:implantahub_api@postgres:5432/implantahub
DATABASE_MIGRATION_URL=postgresql://implantahub_migrator:implantahub_migrator@postgres:5432/implantahub

REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://implantahub:implantahub@rabbitmq:5672
JWT_SECRET=change-this-development-secret-with-at-least-32-characters
COOKIE_SECRET=change-this-cookie-secret-with-at-least-32-characters
ENCRYPTION_KEY=change-this-encryption-key-with-at-least-32-characters
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_API_URL=/api/v1
API_INTERNAL_URL=http://api:3333

MINIO_ROOT_USER=implantahub
MINIO_ROOT_PASSWORD=implantahub-secret
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=implantahub
MINIO_SECRET_KEY=implantahub-secret
MINIO_BUCKET=implantahub-documents
REPORTS_DIR=/app/storage/reports

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=ImplantaHub <no-reply@implantahub.local>
SMTP_USER=
SMTP_PASSWORD=
